{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluvv.se/schemas/manifest.schema.json",
  "title": "Fluvv manifest",
  "description": "Compiled view of every contract and governance file in a Fluvv repo, plus derived lineage and glossary synonyms. Generated by `fluvv compile`; never edited by hand. The input of integrations such as the OpenMetadata push. See docs/fluvv/SPEC.md Section 7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "sourceHash",
    "contracts",
    "domains",
    "glossaries",
    "dataProducts",
    "lineage"
  ],
  "properties": {
    "manifestVersion": {
      "const": "2"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Hash of every contract and governance file this manifest was compiled from."
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Contract"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Domain"
      }
    },
    "glossaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Glossary"
      }
    },
    "dataProducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataProduct"
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tables",
        "columns"
      ],
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contract",
                  "columns"
                ],
                "properties": {
                  "contract": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "description": "The upstream contract id and the columns of it this column is derived from."
              },
              "to": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contract",
                  "column"
                ],
                "properties": {
                  "contract": {
                    "type": "string"
                  },
                  "column": {
                    "type": "string"
                  }
                }
              },
              "function": {
                "type": "string",
                "description": "The expression applied, when the column isn't a plain copy."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "domain",
        "layer",
        "table",
        "owner",
        "columns",
        "upstream",
        "downstream",
        "dataProducts",
        "ingestion",
        "odcs",
        "relationships"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/NullableString"
        },
        "table": {
          "type": "string"
        },
        "physicalName": {
          "$ref": "#/$defs/NullableString"
        },
        "description": {
          "type": "object"
        },
        "owner": {
          "$ref": "#/$defs/NullableString"
        },
        "experts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retention": {
          "$ref": "#/$defs/NullableString",
          "description": "ISO 8601 duration, e.g. P90D."
        },
        "primaryKey": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataProducts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "server": {
          "type": "object"
        },
        "upstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "odcs": {
          "type": "object",
          "description": "The contract document as written (ODCS v3 + Fluvv customProperties)."
        },
        "ingestion": {
          "$ref": "#/$defs/Ingestion"
        },
        "freshness": {
          "$ref": "#/$defs/NullableString",
          "description": "Freshness SLA as an ISO 8601 duration, e.g. P7D or PT6H."
        },
        "relationships": {
          "type": "array",
          "description": "ODCS v3.1.0 relationships (foreign keys), resolved to target contract ids.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "from",
              "to"
            ],
            "properties": {
              "type": {
                "const": "foreignKey"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "to": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contract",
                  "columns"
                ],
                "properties": {
                  "contract": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "logicalType": {
          "type": "string"
        },
        "physicalType": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "businessName": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "primaryKey": {
          "type": "boolean"
        },
        "transformSourceObjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ODCS field, derived: `<contract id>.<column>` of each upstream column."
        },
        "transformLogic": {
          "type": "string",
          "description": "ODCS field, derived: the expression applied."
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner",
        "experts"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/NullableString"
        },
        "owner": {
          "$ref": "#/$defs/NullableString"
        },
        "experts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Glossary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "terms"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/NullableString"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "definition",
              "synonyms",
              "relatedTerms"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "relatedTerms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "DataProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain",
        "owner",
        "contracts"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/NullableString"
        },
        "description": {
          "type": "object"
        },
        "owner": {
          "$ref": "#/$defs/NullableString"
        },
        "experts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "transform",
        "write",
        "mode",
        "effectiveSql"
      ],
      "description": "The resolved ingestion config: contract-backed sources carry their upstream contract id and derived location/format.",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "contract",
              "location",
              "format",
              "read",
              "transform"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "contract": {
                "$ref": "#/$defs/NullableString",
                "description": "Upstream contract id, or null for a pre-contract source."
              },
              "location": {
                "type": "string"
              },
              "format": {
                "type": "string"
              },
              "read": {
                "type": "string"
              },
              "transform": {
                "$ref": "#/$defs/NullableString",
                "description": "Per-source transform SQL, if any."
              }
            }
          }
        },
        "transform": {
          "$ref": "#/$defs/NullableString",
          "description": "Contract-level transform SQL; null when implicit (single source)."
        },
        "write": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "overwrite",
            "append"
          ]
        },
        "effectiveSql": {
          "type": "string",
          "description": "One statement equivalent to the per-source transforms (as CTEs) followed by the contract-level one."
        }
      }
    }
  }
}
